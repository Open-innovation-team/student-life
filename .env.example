# Copier en `.env` et renseigner les valeurs. Ne jamais commiter le .env reel.

# --- PostgreSQL ---
POSTGRES_USER=studentlife_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=studentlife_db

# --- Redis ---
REDIS_PASSWORD=change_me

# --- Connexion Prisma (hors Docker) ---
DATABASE_URL=postgresql://studentlife_user:change_me@localhost:5432/studentlife_db?schema=public

# --- Auth / JWT ---
# Secret de signature des JWT (chaine longue et aleatoire).
JWT_SECRET=change_me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30
# URL du front vers laquelle rediriger apres un login OAuth reussi.
FRONTEND_CALLBACK_URL=http://localhost:3001/auth/callback
# Prefixes de redirection autorises pour les clients non-web (deep links mobile).
# Le client mobile passe ?redirect_uri=<deep link> ; il n'est honore que s'il
# commence par l'un de ces prefixes. studentlife:// = app standalone, exp:// = Expo Go.
OAUTH_ALLOWED_REDIRECT_PREFIXES=studentlife://,exp://
# DEV UNIQUEMENT : active POST /auth/dev-login qui emet des tokens sans OAuth.
# Pratique pour developper sans tunnel https. TOUJOURS false (ou absent) en prod.
DEV_AUTH_BYPASS=false

# --- OAuth Google (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- OAuth Microsoft (https://portal.azure.com -> App registrations) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3000/auth/microsoft/callback
MICROSOFT_TENANT=common
